<service role="DELTA_SHARING" name="delta-sharing" version="1.0.0">
    <metadata>
        <type>API</type>
        <context>/delta-sharing</context>
        <shortDesc>Delta Sharing</shortDesc>
        <description>Delta Sharing protocol server for secure data sharing</description>
        <samples>
            <sample>
                <description>List shares</description>
                <method>GET</method>
                <path>shares</path>
            </sample>
            <sample>
                <description>List schemas in a share</description>
                <method>GET</method>
                <path>shares/{share}/schemas</path>
            </sample>
            <sample>
                <description>List tables in a schema</description>
                <method>GET</method>
                <path>shares/{share}/schemas/{schema}/tables</path>
            </sample>
            <sample>
                <description>Query table metadata</description>
                <method>GET</method>
                <path>shares/{share}/schemas/{schema}/tables/{table}/metadata</path>
            </sample>
        </samples>
    </metadata>
    <routes>
        <route path="/delta-sharing/**?**">
            <rewrite apply="DELTA_SHARING/delta-sharing/inbound/root" to="request.url"/>
        </route>
    </routes>
    <dispatch classname="org.apache.knox.gateway.dispatch.DefaultDispatch" ha-classname="org.apache.knox.gateway.dispatch.DefaultDispatch"/>
    <testURLs>
        <testURL>/delta-sharing/shares</testURL>
    </testURLs>
</service>